# ============================================================================
#  自助付费打印系统 —— 打印助手环境变量模板
#  部署：复制为 /etc/print/agent.env，chmod 600，chown printagent:printagent
#  依据：设计文档 第2章 §1.4 助手环境变量清单（对应 AgentOptions.FromConfiguration）
#  ！！PRINT_AGENT_TOKEN 为敏感凭证，禁止提交到 Git ！！
# ============================================================================

# —— 后端基址（不带 /api/v1）——
PRINT_BACKEND_URL=https://print.example.com

# —— 终端标识与凭证 ——
PRINT_TERMINAL_CODE=TERM-001
PRINT_AGENT_TOKEN=__CHANGE_ME__

# —— 轮询与心跳 ——
PRINT_POLL_INTERVAL_SECONDS=3
PRINT_LONGPOLL_SECONDS=25
PRINT_HEARTBEAT_SECONDS=30

# —— 本地重试 ——
PRINT_MAX_RETRY=3

# —— 本地目录 ——
PRINT_SPOOL_DIR=/var/lib/print-agent/spool
PRINT_LOG_DIR=/var/log/print-agent

# —— 打印后端与打印机 ——
# windows=调用系统打印机；mock=日志模拟出纸
PRINT_PRINT_BACKEND=windows
# 留空表示系统默认打印机
PRINT_PRINTER_NAME=
