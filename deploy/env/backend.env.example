# ============================================================================
#  自助付费打印系统 —— 后端环境变量模板
#  部署：复制为 /etc/print/backend.env，chmod 600，chown print:print
#  依据：设计文档 第2章 §1.4 环境变量 / 配置清单
#  ！！本文件不含真实密钥，禁止将填写后的文件提交到 Git ！！
# ============================================================================

# —— 运行档位与端口（仅监听 127.0.0.1）——
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# —— MySQL ——
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=print_db
MYSQL_USER=print
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_POOL_MAX=20

# —— Redis ——
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__

# —— 鉴权（JWT_SECRET 须 ≥32 字节随机，泄露需轮换）——
JWT_SECRET=__CHANGE_ME_32_BYTES_RANDOM__
JWT_EXPIRE_MINUTES=120

# —— 短信 ——
SMS_PROVIDER=mock
SMS_CODE_TTL_SECONDS=300
SMS_SEND_COOLDOWN_SECONDS=60

# —— 支付 ——
PAYMENT_GATEWAY=mock
ORDER_PAY_EXPIRE_MINUTES=15

# —— 文件存储 ——
FILE_STORAGE_TYPE=local
FILE_ROOT=/data/uploads
FILE_MAX_SIZE_MB=50
FILE_RETENTION_DAYS=30

# —— 打印任务 ——
TASK_CLAIM_TIMEOUT_SECONDS=120
TASK_MAX_RETRY=3
AGENT_OFFLINE_SECONDS=90
RECONCILE_CRON=0 30 3 * * ?
